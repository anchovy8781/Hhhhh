{
  "name": "Ramp into the current limit",
  "device": "sim://psu?channels=1&load=4",
  "safe_shutdown": true,
  "steps": [
    {"op": "load", "channel": 1, "ohms": 4},
    {"op": "set", "channel": 1, "voltage": 0, "current": 1.0},
    {"op": "output", "channel": 1, "state": "on"},
    {"op": "ramp", "name": "0 to 8 V", "channel": 1,
     "from": 0, "to": 8, "seconds": 2, "steps": 8},
    {"op": "check", "name": "supply folded back to CC", "channel": 1,
     "current": {"nominal": 1.0, "tolerance": 0.01},
     "mode": "CC"},
    {"op": "output", "channel": 1, "state": "off"}
  ]
}
